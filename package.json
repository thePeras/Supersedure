{
  "name": "bks-root",
  "version": "1.0.0",
  "repository": "git@github.com:thePeras/supersedure-studio.git",
  "author": "Matthew Rathbone <matthew.rathbone@gmail.com>",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "bks:build": "yarn lib:build && yarn workspace supersedure-studio electron:build",
    "bks:dev": "yarn lib:build && yarn workspace supersedure-studio electron:serve",
    "bks:config:build": "yarn workspace supersedure-studio config:build",
    "lib:dev": "yarn workspace @supersedure-studio/ui-kit lib:dev",
    "lib:build": "yarn workspace @supersedure-studio/ui-kit build",
    "sqltools:build": "yarn workspace sqltools build",
    "sqltools:dev": "yarn workspace sqltools serve",
    "electron:build": "yarn bks:build",
    "electron:serve": "yarn bks:dev",
    "docs:serve": "yarn workspace supersedure-studio docs:serve",
    "web:serve": "yarn sqltools:dev",
    "test:e2e": "yarn workspace supersedure-studio test:e2e",
    "test:e2e:ci": "yarn workspace supersedure-studio test:e2e:ci",
    "test:integration": "yarn workspace supersedure-studio test:integration",
    "test:unit": "yarn workspace supersedure-studio test:unit && yarn workspace @supersedure-studio/ui-kit test",
    "vitest:unit": "yarn workspace supersedure-studio vitest:unit",
    "vitest:integration": "yarn workspace supersedure-studio vitest:integration",
    "vitest:ci": "yarn workspace supersedure-studio vitest:ci",
    "test:ci": "yarn workspace supersedure-studio test:ci",
    "test:codemirror": "yarn workspace supersedure-studio test:codemirror",
    "all:lint": "yarn workspace supersedure-studio lint",
    "postinstall": "husky install",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "devDependencies": {
    "husky": "8.0.3",
    "pinst": "^3.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "resolutions": {
    "cpu-features": "file:./.yarn/packages/empty-package",
    "**/axios": "^1.15.0",
    "node-abi": "^4.35.0",
    "nan": "^2.28.0"
  }
}
